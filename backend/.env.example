# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rainsense?retryWrites=true&w=majority
DB_NAME=rainsense

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Weather API
OPENWEATHER_API_KEY=your-openweather-api-key

# YOLO
YOLO_MODEL_PATH=yolov8n.pt

# App Settings
DEMO_MODE=true
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# CORS
FRONTEND_URL=http://localhost:5173
